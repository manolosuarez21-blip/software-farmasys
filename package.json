{
  "name": "farmasys",
  "version": "1.2.0",
  "description": "Sistema de farmacia con frontend, backend y base de datos local en SQLite",
  "main": "electron-main.js",
  "author": "FARMAsys",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "build:exe": "electron-builder --win"
  },
  "build": {
    "appId": "com.farmasys.app",
    "productName": "FARMAsys",
    "npmRebuild": false,
    "files": [
      "**/*",
      "!dist/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FARMAsys"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "mongodb": "^7.4.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}